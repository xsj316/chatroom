{
    "name": "secure-chatroom",
    "version": "1.0.0",
    "description": "轻量加密网页聊天室：Node.js + Express + Socket.IO + Web Crypto API，AES-256-GCM 加密消息、SHA-256 加盐哈希密码",
    "main": "server.js",
    "type": "commonjs",
    "scripts": {
        "start": "node start.js",
        "dev": "node --watch start.js"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "keywords": [
        "chatroom",
        "socket.io",
        "aes-256-gcm",
        "websocket",
        "encryption"
    ],
    "license": "MIT",
    "dependencies": {
        "express": "^4.19.2",
        "socket.io": "^4.7.5"
    },
    "pkg": {
        "assets": [
            "public/**/*",
            "node_modules/socket.io/client-dist/**/*"
        ],
        "targets": [
            "node18-win-x64"
        ]
    },
    "devDependencies": {
        "@noble/ciphers": "^1.2.1",
        "@noble/curves": "^1.9.0",
        "@noble/hashes": "^1.8.0",
        "esbuild": "^0.28.2",
        "pkg": "^5.8.1"
    }
}
